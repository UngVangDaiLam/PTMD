# --- Mẫu độc: TUYỆT ĐỐI không commit (CLAUDE.md mục 9, 10) ---
data/malicious/*
data/injection/*
!data/malicious/.gitkeep
!data/injection/.gitkeep

# File nén mẫu
*.zip
*.whl
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tar.xz
*.7z
*.rar
*.egg

# Bí mật
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Cache tra cứu hash, mô hình đã huấn luyện, thư mục tạm
.cache/
ml/*.joblib
ml/*.pkl
tmp/

# IDE / hệ điều hành
.vscode/
.idea/
.DS_Store
Thumbs.db
